      "file": "06.jpg",
      "sha256": "43c1f0ecc2c451e8ea31c82d9799163ced7ec9d8b0613d4866a429f1a1612542",
      "bytes": 242873,
      "native_width": 5616,
      "native_height": 3744,
      "content_role": "medical-philological-treatises",
      "state": "initial-read",
      "sides": [
        {
          "side": "right",
          "columns": [
            {
              "text": "千金方及翼方引此條作陰易之病醫心方"
            },
            {
              "text": "引葛氏方亦稱陰易病宋無求子及南陽活"
            },
            {
              "text": "人書陳無擇三因方引經文並作陰"
            },
            {
              "text": "易之為病朱肱無擇輩皆治平以後之人去"
            },
            {
              "text": "林億等挍正之時猶未數十年則宋臣挍正"
            },
            {
              "text": "舊本無陽字從可見已逮金成無己據玉函"
            },
            {
              "text": "經作陰陽易之為病明萬曆中趙開美刻仲"
            },
            {
              "text": "景全書後挍刻宋板亦從成氏本始補以陽"
            },
            {
              "text": "字以其無空位故細書補填之而已後人因"
            }
          ],
          "extras": [
            {
              "type": "printed-small-text",
              "location": "右面第3欄「人書」下雙行小註",
              "text": "醫方類／聚引",
              "column_anchor": 9,
              "color": "unknown",
              "lines": [
                "醫方類",
                "聚引"
              ]
            },
            {
              "type": "running-title",
              "location": "版心葉次",
              "text": "二",
              "column_anchor": 9,
              "color": "unknown"
            }
          ]
        },
        {
          "side": "left",
          "columns": [
            {
              "text": "循莫之能悟長沙舊文遂屬隱晦可嘆也已"
            },
            {
              "text": "爰為之辨如右"
            },
            {
              "text": "己酉夏六月　棠邊丹波元佶撰"
            }
          ],
          "extras": []
        }

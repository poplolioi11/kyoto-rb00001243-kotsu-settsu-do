        {
          "side": "left",
          "columns": [
            {
              "text": "㽲痛切痛同"
            },
            {
              "text": "㽲痛字昉見金匱當歸生姜羊肉湯及當歸"
            },
            {
              "text": "芍藥散條切痛字見附子粳米湯條㽲字説"
            },
            {
              "text": "文不載按㽲者㽱之俗體説文云㽱腹中急"
            },
            {
              "text": "痛也集韻音絞千金外臺倶引㽲作絞此則"
            },
            {
              "text": "㽲痛卽絞痛絞之義為急故論語直而無禮"
            },
            {
              "text": "則絞鄭玄云絞急也切亦訓急氣交變大論"
            },
            {
              "text": "其政勁切王注切急也左傳昭公元年叔孫"
            },
            {
              "text": "絞而婉杜注絞切也廣韻切迫也毛晃增注"
            }
          ],
          "extras": [
            {
              "type": "seal",
              "location": "右側長方朱印",
              "text": "富士川游寄贈",
              "column_anchor": 9,
              "color": "red"
            },
            {
              "type": "seal",
              "location": "欄外五視印",
              "text": "□",
              "column_anchor": 9,
              "color": "unknown"
            }
          ]
        }
      ],

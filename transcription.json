      "canvas_id": "https://rmda.kulib.kyoto-u.ac.jp/iiif/RB00001243/canvas/p6",
      "image_url": "https://rmda.kulib.kyoto-u.ac.jp/iiif/3/RB00001243%2FRB00001243_00006_0.ptif/full/2000,/0/default.jpg",
      "label": {
